PORT=3000
PUBLIC_BASE_URL=https://<tunnel-host>

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0

LUZMO_API_KEY=
LUZMO_API_TOKEN=
LUZMO_HOST=https://api.luzmo.com
LUZMO_DATASET_ID=
LUZMO_TENANT_COLUMN_ID=
# Optional. Unset / empty = Luzmo defaults (recommended for showcases).
# Set to a saved theme UUID or built-in id (vivid, orion, default_dark, …).
LUZMO_THEME_ID=
# IANA timezone for /AIPrompt answers (default UTC)
LUZMO_TIMEZONE_ID=UTC

ALLOWLIST_PATH=./config/allowlist.json
# Lambda: paste the full allowlist JSON as a single-line string (overrides ALLOWLIST_PATH).
# ALLOWLIST_JSON=

# sqlite (local default) | dynamodb (Lambda)
STORAGE_BACKEND=sqlite
SQLITE_PATH=./data/whatsapp-analyst.sqlite
# DYNAMODB_TABLE_NAME=whatsapp-analyst
# AWS_REGION=eu-west-1

CONVERSATION_IDLE_MINUTES=60
AIPROMPT_TIMEOUT_MS=120000

{
  "name": "whatsapp-analyst",
  "version": "1.0.0",
  "description": "WhatsApp bot for governed analytics Q&A via Luzmo /AIPrompt (agent: analyst)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-sqlite --import tsx src/server.ts",
    "dev:watch": "node --experimental-sqlite --watch --import tsx src/server.ts",
    "start": "node --experimental-sqlite dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-sqlite ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --experimental-sqlite ./node_modules/vitest/vitest.mjs",
    "verify-config": "tsx scripts/verify-config.ts",
    "themes:list": "tsx scripts/list-themes.ts",
    "smoke:meta": "tsx scripts/smoke-meta.ts",
    "smoke:luzmo": "tsx scripts/smoke-luzmo.ts"
  },
  "dependencies": {
    "@luzmo/nodejs-sdk": "^4.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}

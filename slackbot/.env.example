# Slack App credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Comma-separated dataset IDs pinned for every /AIPrompt analyst call
DATASET_IDS=dataset-id-1,dataset-id-2

# Luzmo API host (optional, defaults to https://api.luzmo.com)
LUZMO_HOST=https://api.luzmo.com

# Mint scoped embed tokens for /AIPrompt (recommended). Set to false to use org API keys directly.
AIPROMPT_USE_EMBED_AUTH=true

{
  "name": "devops-command-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ci": "npx ng build --base-href=/devops-command/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@9.2.0",
  "dependencies": {
    "@angular/common": "22.0.4",
    "@angular/compiler": "22.0.4",
    "@angular/core": "22.0.4",
    "@angular/forms": "22.0.4",
    "@angular/platform-browser": "22.0.4",
    "@angular/router": "22.0.4",
    "@luzmo/analytics-components-kit": "1.0.2",
    "@luzmo/dashboard-contents-types": "1.0.28",
    "@luzmo/ngx-embed": "8.7.5",
    "rxjs": "~7.8.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.0.4",
    "@angular/cli": "21.1.4",
    "@angular/compiler-cli": "22.0.4",
    "@tailwindcss/postcss": "4.1.18",
    "jsdom": "28.1.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}

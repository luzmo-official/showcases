# Luzmo embed configuration (RouteData)
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored and must never be committed.
#
# This app has no backend and is a static export, so these are inlined into the
# client bundle at build time (mapped into the bundle via `env` in
# next.config.ts). Only the derived EMBED key/token go here — never the Luzmo
# API key/token.

# Embed authorization id + token (mint with the Node SDK — see README).
ROUTEDATA_LUZMO_EMBED_KEY=
ROUTEDATA_LUZMO_EMBED_TOKEN=

# ISO timestamp when the embed expires — re-mint before this date.
ROUTEDATA_LUZMO_EMBED_EXPIRY=

# Dataset the embed token is scoped to.
ROUTEDATA_LUZMO_DATASET_ID=

# Regional hosts (optional — defaults to EU).
ROUTEDATA_LUZMO_API_HOST=https://api.luzmo.com
ROUTEDATA_LUZMO_APP_SERVER=https://app.luzmo.com
